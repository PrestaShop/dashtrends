{% import '@PrestaShop/Admin/Dashboard/_partials/chart.html.twig' as dashboard %}

<div class="card">
  <div class="card-header">
    <h3 class="card-header-title">{{ title }}</h3>
  </div>
  <div class="card-body">
    {{ dashboard.renderChart(chartId, chartConfig, {height: 300, label: title}) }}
  </div>
</div>
