<div class="card">
  <div class="card-header">
    <h3 class="card-header-title">{{ title }}</h3>
  </div>
  <div class="card-body">
    <canvas id="{{ chartId }}" data-chart height="80" role="img" aria-label="{{ title }}"></canvas>
    <script type="application/json" id="{{ chartId }}-data">{{ chartConfig|raw }}</script>
  </div>
</div>
