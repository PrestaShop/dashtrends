{% import '@PrestaShop/Admin/Dashboard/_partials/card_header.html.twig' as dashboard %}
{% import '@PrestaShop/Admin/Dashboard/_partials/chart.html.twig' as chart %}

<div class="card">
  {{ dashboard.renderCardHeader(title, 'show_chart', null) }}
  <div class="card-body">
    {{ chart.renderChart(chartId, chartConfig, {height: 300, label: title}) }}
  </div>
</div>
